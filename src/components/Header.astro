---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, whatsappLink } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="G'Forge Foods home"><Logo height={46} /></a>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary nav-cta" href={whatsappLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Order Now
      </a>
    </nav>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const header = document.querySelector('.site-header')!;
  btn.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(253, 251, 247, .94);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 68px; gap: 16px; }
  .brand { text-decoration: none; display: flex; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 4px; }
  .nav a:not(.btn) {
    display: block; padding: 10px 14px; border-radius: 999px;
    font-family: var(--font-head); font-weight: 600; font-size: .95rem;
    color: var(--ink); text-decoration: none;
  }
  .nav a:not(.btn):hover { background: var(--green-50); color: var(--green); }
  .nav a[aria-current='page'] { color: var(--orange); }
  .menu-toggle {
    display: none; background: none; border: 0; padding: 10px; margin-right: -10px;
    color: var(--green); cursor: pointer;
  }
  .menu-toggle :global(svg) { width: 28px; height: 28px; }
  .i-close { display: none; }

  @media (min-width: 961px) {
    .nav { display: flex; align-items: center; gap: 12px; }
  }
  @media (max-width: 960px) {
    .menu-toggle { display: block; }
    .nav {
      display: none; position: fixed; inset: 68px 0 0 0; background: var(--cream);
      padding: 24px var(--gutter); overflow-y: auto;
    }
    .nav ul { flex-direction: column; gap: 2px; margin-bottom: 24px; }
    .nav a:not(.btn) { font-size: 1.2rem; padding: 14px 8px; border-radius: 8px; }
    .nav-cta { width: 100%; }
    .site-header:global(.open) .nav { display: block; }
    .site-header:global(.open) :global(.i-open) { display: none; }
    .site-header:global(.open) :global(.i-close) { display: block; }
  }
</style>
